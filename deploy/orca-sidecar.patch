diff --git a/README.windows.md b/README.windows.md
new file mode 100644
index 0000000..cf2b3c1
--- /dev/null
+++ b/README.windows.md
@@ -0,0 +1,103 @@
+# Windows Orca sidecar for Bambuddy
+
+This installation runs the Orca API wrapper on Windows, with a dedicated copy
+of the custom OrcaSlicer build. The API is available at
+`http://127.0.0.1:3003`; Dockerized Bambuddy reaches it at
+`http://host.docker.internal:3003`.
+
+The runtime executable, DLLs and profile resources are copied from
+`C:\CustomOrcaSlicer\OrcaSlicer_3leVersion\build\src\Release`. The copied
+DLL has the same SHA256 as the desktop build. `runtime/build.json` records
+the version, source revision at snapshot time, and DLL hash.
+
+The service starts at Windows logon using the scheduled task
+**Bambuddy Orca API**. It runs under the current Windows user, with hidden
+windows. Diagnostics are in `logs/sidecar.stderr.log` and
+`logs/sidecar.stdout.log`.
+
+## Controls
+
+```powershell
+Start-ScheduledTask -TaskName 'Bambuddy Orca API'
+Invoke-RestMethod http://127.0.0.1:3003/health
+```
+
+To stop the service, stop its task and then its tracked Node process:
+
+```powershell
+Stop-ScheduledTask -TaskName 'Bambuddy Orca API'
+& C:\Bambuddy\OrcaSlicer_API\scripts\stop-windows.ps1
+```
+
+## Rebuild after changing Orca
+
+Finish building the desktop Orca fork first. Stop the sidecar, then run:
+
+```powershell
+Set-Location C:\Bambuddy\OrcaSlicer_API
+& .\scripts\build-windows.ps1
+Start-ScheduledTask -TaskName 'Bambuddy Orca API'
+```
+
+The builder refreshes the executable, DLLs and resources together. Dependencies
+are pinned by `package-lock.json`. Initial dependency installation uses
+`npm ci`; the local compiled service runs with the Node executable copied
+into `runtime`.
+
+## Desktop profiles
+
+The deployed Bambuddy fork now provides **Profiles → Local Profiles → Sync
+desktop Orca profiles**. Save changes in desktop Orca before clicking. The
+button reads this PC's configured account folder through the companion API,
+updates managed profiles, and reports conflicts and removed profiles. Use
+this button for routine syncs; it maintains tracking for edits made in Bambuddy.
+The deployment script configures the folder and a shared authentication token.
+
+Bambuddy sends the selected profiles with each API request. Its imported local
+presets are snapshots; saving a desktop preset does not automatically modify
+Bambuddy's copy. The earlier CLI sync below remains available for recovery,
+but it bypasses the button's conflict tracking and should not be used for
+routine syncs after adopting profiles through the button:
+
+```powershell
+Set-Location C:\Bambuddy\OrcaSlicer_API
+python scripts/sync-desktop-profiles.py --source 'C:\Users\3leme\AppData\Roaming\OrcaSlicer\user\5e5d6945-094f-439c-bad1-a5399dcb4267'
+```
+
+This resolves presets against this sidecar's matching resource tree and updates
+same-named entries under **Bambuddy → Profiles → Local Profiles**. It also
+stores the resolved JSON under `data/printers`, `data/presets`, and
+`data/filaments`. Filament ordering is supplied by Bambuddy per print.
+
+The custom machine/process identity patch retains `from: User` and the
+original system `inherits` after flattening. Orca then compares a renamed
+printer such as Vulcan against its correct Bambu parent. Filaments retain the
+CLI's required `system` marker.
+
+## Verification
+
+`scripts/verify-slice.py` sends the same multipart fields used by Bambuddy:
+`file`, `printerProfile`, `presetProfile`, repeated `filamentProfile`,
+`plate`, `exportType`, and `requestId`. It verifies the output ZIP and checks
+for nonempty embedded G-code. Reports and sliced sample files are stored in
+`data/verification`.
+
+The Bambuddy integration test also uploaded `X2D_Riser_Test.3mf` to the
+**Orca API verification** Library folder and sliced plate 1 through
+`POST /api/v1/library/files/{file_id}/slice`. Job 1 completed in approximately
+18 seconds, reported `used_embedded_settings: false`, and produced valid
+embedded G-code. A deliberate `layer_height: 0.25` override was verified in
+the resulting project settings, proving that Bambuddy's selected profile
+path was used. `data/verification/bambuddy-x2d.report.json` records the result.
+No print was dispatched. The wrapper's 115 unit tests and source ESLint check
+passed after the Windows and custom-profile changes.
+
+Windows Orca does not implement the Linux `--pipe` progress stream. This
+installation publishes initial and final request status; percentage updates
+during slicing are unavailable. Bambuddy's stall timeout therefore limits a
+Windows slice that produces no progress updates. Keep Windows awake while
+remote slicing is needed.
+
+The running Bambuddy image is now built from the local `Bambuddy_OrcaAPI`
+fork. Run `C:\Bambuddy\Update-BambuddyFork.ps1` to rebuild and deploy the
+current checkout. It does not automatically merge upstream changes.
diff --git a/scripts/build-windows.ps1 b/scripts/build-windows.ps1
new file mode 100644
index 0000000..a6480dc
--- /dev/null
+++ b/scripts/build-windows.ps1
@@ -0,0 +1,85 @@
+param(
+    [string]$OrcaRoot = 'C:\CustomOrcaSlicer\OrcaSlicer_3leVersion',
+    [string]$NodePath = (Get-Command node -ErrorAction Stop).Source
+)
+
+$ErrorActionPreference = 'Stop'
+$apiRoot = Split-Path $PSScriptRoot -Parent
+$source = Join-Path $OrcaRoot 'build\src\Release'
+$runtime = Join-Path $apiRoot 'runtime'
+$destination = Join-Path $runtime 'orca'
+$dll = Join-Path $source 'OrcaSlicer.dll'
+if (-not (Test-Path -LiteralPath $dll)) { throw "Build Orca first: $dll is missing." }
+if (-not (Test-Path -LiteralPath (Join-Path $source 'resources\profiles\BBL'))) {
+    throw 'The Orca build does not contain its BBL profile resources.'
+}
+if (Test-Path -LiteralPath (Join-Path $runtime 'sidecar.pid')) {
+    $savedPid = [int](Get-Content (Join-Path $runtime 'sidecar.pid'))
+    if (Get-Process -Id $savedPid -ErrorAction SilentlyContinue) {
+        throw 'Stop the sidecar before replacing its runtime snapshot.'
+    }
+}
+New-Item -ItemType Directory -Force -Path $destination | Out-Null
+$before = (Get-FileHash -LiteralPath $dll -Algorithm SHA256).Hash
+Get-ChildItem -LiteralPath $source -File | Where-Object {
+    $_.Extension -eq '.dll' -or $_.Name -eq 'orca-slicer.exe'
+} | Copy-Item -Destination $destination -Force
+foreach ($folder in @('resources', 'python')) {
+    $srcFolder = Join-Path $source $folder
+    if (Test-Path -LiteralPath $srcFolder) {
+        $target = [IO.Path]::GetFullPath((Join-Path $destination $folder))
+        $allowed = [IO.Path]::GetFullPath($destination).TrimEnd('\') + '\'
+        if (-not $target.StartsWith($allowed, [StringComparison]::OrdinalIgnoreCase)) {
+            throw "Snapshot target is outside the runtime: $target"
+        }
+        & robocopy $srcFolder $target /MIR /MT:8 /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null
+        if ($LASTEXITCODE -gt 7) { throw "Snapshot copy failed: $srcFolder" }
+    }
+}
+$after = (Get-FileHash -LiteralPath $dll -Algorithm SHA256).Hash
+$copied = (Get-FileHash -LiteralPath (Join-Path $destination 'OrcaSlicer.dll') -Algorithm SHA256).Hash
+if ($before -ne $after -or $before -ne $copied) {
+    throw 'Orca changed during the snapshot. Run the builder after its build finishes.'
+}
+Copy-Item -LiteralPath $NodePath -Destination (Join-Path $runtime 'node.exe') -Force
+Copy-Item -LiteralPath (Join-Path $OrcaRoot 'LICENSE.txt') -Destination (Join-Path $destination 'LICENSE.txt') -Force
+$versionText = Get-Content (Join-Path $OrcaRoot 'version.inc') -Raw
+$version = [regex]::Match($versionText, 'set\(SoftFever_VERSION "([^"]+)"\)').Groups[1].Value
+if (-not $version) { throw 'Could not read the Orca version.' }
+$revision = (& git -C $OrcaRoot rev-parse HEAD).Trim()
+$manifest = [ordered]@{
+    version = $version
+    source_revision_at_snapshot = $revision
+    source_directory = $OrcaRoot
+    orca_dll_sha256 = $copied
+    source_dll_modified_utc = (Get-Item $dll).LastWriteTimeUtc.ToString('o')
+    snapshot_utc = [DateTime]::UtcNow.ToString('o')
+    api_revision = (& git -C $apiRoot rev-parse HEAD).Trim()
+}
+$manifest | ConvertTo-Json | Set-Content (Join-Path $runtime 'build.json') -Encoding utf8
+New-Item -ItemType Directory -Force -Path (Join-Path $apiRoot 'data\tmp') | Out-Null
+$syncConfiguration = @()
+if (Test-Path (Join-Path $apiRoot '.env')) {
+    $syncConfiguration = @(Get-Content (Join-Path $apiRoot '.env') | Where-Object { $_ -match '^DESKTOP_(PROFILES_PATH|PROFILE_SYNC_TOKEN)=' })
+}
+@(
+    'NODE_ENV=production'
+    'HOST=127.0.0.1'
+    'PORT=3003'
+    "ORCASLICER_PATH=$($destination.Replace('\','/'))/orca-slicer.exe"
+    "ORCASLICER_VERSION=$version"
+    "BUNDLED_PROFILES_PATH=$($destination.Replace('\','/'))/resources/profiles/BBL"
+    "DATA_PATH=$($apiRoot.Replace('\','/'))/data"
+    'SLICER_FLAVOR=orca'
+    'MAX_MODEL_UPLOAD_MB=512'
+    'CORS_ORIGINS=http://127.0.0.1:8000'
+    $syncConfiguration
+) | Set-Content (Join-Path $apiRoot '.env') -Encoding utf8
+Push-Location $apiRoot
+try {
+    & $NodePath 'node_modules\typescript\bin\tsc'
+    if ($LASTEXITCODE -ne 0) { throw 'TypeScript build failed.' }
+    & $NodePath 'node_modules\tsc-esm-fix\target\esm\cli.mjs' 'dist'
+    if ($LASTEXITCODE -ne 0) { throw 'ES module path fix failed.' }
+} finally { Pop-Location }
+Write-Output "Built API with Orca $version; DLL SHA256 $copied"
