diff --git a/scripts/sync-desktop-profiles.py b/scripts/sync-desktop-profiles.py
new file mode 100644
index 0000000..2e4811e
--- /dev/null
+++ b/scripts/sync-desktop-profiles.py
@@ -0,0 +1,61 @@
+"""Copy desktop custom presets to Bambuddy using this sidecar's base profiles."""
+import argparse
+import json
+import urllib.request
+from pathlib import Path
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--source', type=Path, required=True, help='Orca user directory containing machine/process/filament folders')
+parser.add_argument('--api', default='http://127.0.0.1:3003')
+parser.add_argument('--bambuddy', default='http://127.0.0.1:8000')
+args = parser.parse_args()
+api_root = Path(__file__).resolve().parent.parent
+
+
+def request(url, data=None, method=None):
+    payload = None if data is None else json.dumps(data).encode()
+    req = urllib.request.Request(url, data=payload, method=method,
+        headers={'Content-Type': 'application/json'})
+    with urllib.request.urlopen(req, timeout=60) as response:
+        return json.load(response)
+
+
+existing = request(args.bambuddy.rstrip('/') + '/api/v1/local-presets/')
+by_name = {preset['name']: preset for values in existing.values() for preset in values}
+summary = []
+for category, preset_type, disk_category in (
+    ('machine', 'printer', 'printers'), ('process', 'process', 'presets'), ('filament', 'filament', 'filaments')
+):
+    folder = args.source / category
+    if not folder.is_dir():
+        raise RuntimeError(f'Missing desktop profile directory: {folder}')
+    for path in sorted(folder.rglob('*.json')):
+        raw = json.loads(path.read_text(encoding='utf-8-sig'))
+        if not raw.get('name'):
+            continue
+        resolved = request(args.api.rstrip('/') + '/profiles/resolve', {'category': category, 'profile': raw})['profile']
+        resolved['type'] = category
+        resolved.setdefault('from', 'system')
+        if category == 'machine' and not resolved.get('machine_start_gcode'):
+            raise RuntimeError(f'{raw["name"]}: no resolved start G-code')
+        if category == 'process' and not resolved.get('compatible_printers'):
+            raise RuntimeError(f'{raw["name"]}: no resolved compatible printer list')
+        previous = by_name.get(raw['name'])
+        base_url = args.bambuddy.rstrip('/') + '/api/v1/local-presets/'
+        if previous:
+            if previous['preset_type'] != preset_type:
+                raise RuntimeError(f'A preset with another type already uses {raw["name"]}')
+            saved = request(base_url + str(previous['id']), {'setting': resolved}, 'PUT')
+            action = 'updated'
+        else:
+            saved = request(base_url, {'name': raw['name'], 'preset_type': preset_type, 'setting': resolved}, 'POST')
+            by_name[raw['name']] = saved
+            action = 'created'
+        destination = api_root / 'data' / disk_category / path.name
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        destination.write_text(json.dumps(resolved, indent=2), encoding='utf-8')
+        summary.append({'id': saved['id'], 'name': raw['name'], 'type': preset_type,
+                        'source': str(path), 'action': action, 'resolved_file': str(destination)})
+        print(f'{action}: {raw["name"]}', flush=True)
+(api_root / 'data' / 'desktop-profile-sync.json').write_text(json.dumps(summary, indent=2), encoding='utf-8')
+print(f'Synchronized {len(summary)} custom desktop profiles.')
diff --git a/scripts/verify-slice.py b/scripts/verify-slice.py
new file mode 100644
index 0000000..8b025eb
--- /dev/null
+++ b/scripts/verify-slice.py
@@ -0,0 +1,78 @@
+"""Send a real Bambuddy-shaped multipart slice request, using stdlib only."""
+import argparse
+import io
+import json
+import time
+import urllib.error
+import urllib.request
+import uuid
+import zipfile
+from pathlib import Path
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--api', default='http://127.0.0.1:3003')
+parser.add_argument('--model', type=Path, required=True)
+parser.add_argument('--plate', default='1')
+parser.add_argument('--printer', type=Path)
+parser.add_argument('--process', type=Path)
+parser.add_argument('--filament', type=Path, action='append', default=[])
+parser.add_argument('--output', type=Path, required=True)
+args = parser.parse_args()
+if bool(args.printer) != bool(args.process):
+    parser.error('Pass both --printer and --process.')
+boundary = '----orca-api-' + uuid.uuid4().hex
+request_id = uuid.uuid4().hex
+parts = []
+
+
+def field(name, value):
+    parts.append((f'--{boundary}\r\nContent-Disposition: form-data; name="{name}"\r\n\r\n{value}\r\n').encode())
+
+
+def file(name, path, mime, filename):
+    parts.append((f'--{boundary}\r\nContent-Disposition: form-data; name="{name}"; filename="{filename}"\r\nContent-Type: {mime}\r\n\r\n').encode())
+    parts.append(path.read_bytes())
+    parts.append(b'\r\n')
+
+
+file('file', args.model, 'model/3mf', args.model.name)
+if args.printer:
+    file('printerProfile', args.printer, 'application/json', 'printer.json')
+    file('presetProfile', args.process, 'application/json', 'preset.json')
+for idx, path in enumerate(args.filament):
+    file('filamentProfile', path, 'application/json', f'filament_{idx + 1}.json')
+field('plate', args.plate)
+field('exportType', '3mf')
+field('requestId', request_id)
+body = b''.join(parts) + f'--{boundary}--\r\n'.encode()
+request = urllib.request.Request(args.api.rstrip('/') + '/slice', data=body,
+    headers={'Content-Type': f'multipart/form-data; boundary={boundary}'}, method='POST')
+print(f'Slicing {args.model.name}, plate {args.plate}, {len(args.filament)} uploaded filament profiles', flush=True)
+started = time.monotonic()
+report = {'model': str(args.model), 'plate': args.plate, 'request_id': request_id,
+          'api': args.api, 'uploaded_profiles': bool(args.printer)}
+try:
+    with urllib.request.urlopen(request, timeout=600) as response:
+        result = response.read()
+        report.update(status=response.status, bytes=len(result), headers=dict(response.headers))
+except urllib.error.HTTPError as error:
+    report.update(status=error.code, error=error.read().decode('utf-8', 'replace'))
+    result = None
+report['elapsed_seconds'] = round(time.monotonic() - started, 2)
+if result is not None:
+    with zipfile.ZipFile(io.BytesIO(result)) as archive:
+        if archive.testzip() is not None:
+            raise RuntimeError('Corrupt output ZIP')
+        gcodes = [(entry.filename, entry.file_size) for entry in archive.infolist() if entry.filename.endswith('.gcode')]
+        if not gcodes or not all(size > 0 for _, size in gcodes):
+            raise RuntimeError('The response contains no G-code')
+        report['gcodes'] = gcodes
+        settings = json.loads(archive.read('Metadata/project_settings.config'))
+        report['settings'] = {key: settings.get(key) for key in
+            ('printer_model', 'printer_variant', 'nozzle_diameter', 'layer_height', 'print_settings_id', 'filament_settings_id')}
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_bytes(result)
+args.output.parent.mkdir(parents=True, exist_ok=True)
+args.output.with_suffix('.report.json').write_text(json.dumps(report, indent=2), encoding='utf-8')
+print(json.dumps(report, indent=2), flush=True)
+raise SystemExit(0 if report.get('status') == 200 else 1)
