index 0000000..cac5395
--- /dev/null
+++ b/scripts/start-windows.ps1
@@ -0,0 +1,31 @@
+param([switch]$Wait)
+
+$ErrorActionPreference = 'Stop'
+$apiRoot = Split-Path $PSScriptRoot -Parent
+$runtime = Join-Path $apiRoot 'runtime'
+$node = Join-Path $runtime 'node.exe'
+$pidPath = Join-Path $runtime 'sidecar.pid'
+if (Test-Path $pidPath) {
+    $savedPid = [int](Get-Content $pidPath)
+    $existing = Get-CimInstance Win32_Process -Filter "ProcessId = $savedPid"
+    if ($existing -and $existing.ExecutablePath -eq $node) {
+        Write-Output "Orca API already running (PID $savedPid)."
+        if ($Wait) { Wait-Process -Id $savedPid; exit 1 }
+        exit 0
+    }
+}
+if (-not (Test-Path (Join-Path $apiRoot 'dist\src\index.js'))) { throw 'Build the API first.' }
+$logs = Join-Path $apiRoot 'logs'
+New-Item -ItemType Directory -Force -Path $logs | Out-Null
+$env:TEMP = Join-Path $apiRoot 'data\tmp'
+$env:TMP = $env:TEMP
+$child = Start-Process -FilePath $node -ArgumentList '--env-file=.env', 'dist/src/index.js' `
+    -WorkingDirectory $apiRoot -WindowStyle Hidden -PassThru `
+    -RedirectStandardOutput (Join-Path $logs 'sidecar.stdout.log') `
+    -RedirectStandardError (Join-Path $logs 'sidecar.stderr.log')
+$child.Id | Set-Content $pidPath
+Write-Output "Started Orca API (PID $($child.Id)); http://127.0.0.1:3003/health"
+if ($Wait) {
+    $child.WaitForExit()
+    exit $child.ExitCode
+}
