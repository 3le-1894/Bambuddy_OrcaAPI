+import { afterEach, describe, expect, it } from "vitest";
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { authorizedSync, desktopProfiles } from "../../src/routes/profiles/desktop-sync";
+
+const roots: string[] = [];
+const original = { ...process.env };
+afterEach(async () => {
+  process.env = { ...original };
+  for (const root of roots.splice(0)) await fs.rm(root, { recursive: true, force: true });
+});
+
+describe("desktop profile sync", () => {
+  it("requires the configured bearer token", () => {
+    expect(authorizedSync(undefined, undefined)).toBe(false);
+    expect(authorizedSync("Bearer wrong", "secret")).toBe(false);
+    expect(authorizedSync("Bearer secret", "secret")).toBe(true);
+  });
+  it("does not write snapshots when any desktop profile is invalid", async () => {
+    const root = await fs.mkdtemp(path.join(os.tmpdir(), "orca-sync-test-"));
+    roots.push(root);
+    process.env.DESKTOP_PROFILES_PATH = root;
+    process.env.BUNDLED_PROFILES_PATH = root;
+    process.env.DATA_PATH = path.join(root, "output");
+    for (const category of ["machine", "process", "filament"]) await fs.mkdir(path.join(root, category));
+    await fs.writeFile(path.join(root, "machine", "printer.json"), JSON.stringify({ name: "Printer", machine_start_gcode: "G28" }));
+    await fs.writeFile(path.join(root, "process", "broken.json"), "{broken");
+    await expect(desktopProfiles()).rejects.toThrow();
+    await expect(fs.stat(path.join(root, "output", "printers"))).rejects.toThrow();
+  });
+});
