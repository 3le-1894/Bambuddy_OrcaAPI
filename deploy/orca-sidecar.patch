--- /dev/null
+++ b/src/routes/profiles/desktop-sync.ts
@@ -0,0 +1,59 @@
+import fs from "node:fs/promises";
+import path from "node:path";
+import { timingSafeEqual } from "node:crypto";
+import { AppError } from "../../middleware/error";
+import { getDefaultBundledProfilesPath, resolveProfile, preserveCustomPresetIdentity, type ProfileCategory, type ProfileJson } from "../slicing/profile-resolver";
+
+export function authorizedSync(header: string | undefined, token: string | undefined): boolean {
+  if (!token || !header) return false;
+  const expected = Buffer.from(`Bearer ${token}`);
+  const supplied = Buffer.from(header);
+  return expected.length === supplied.length && timingSafeEqual(expected, supplied);
+}
+
+export async function desktopProfiles() {
+  const source = process.env.DESKTOP_PROFILES_PATH;
+  const bundledProfilesPath = getDefaultBundledProfilesPath();
+  if (!source || !bundledProfilesPath) throw new AppError(503, "Desktop profile sync is not configured.");
+  const root = await fs.realpath(source);
+  const data = process.env.DATA_PATH ?? "data";
+  let legacy: Array<{ id: number; source: string; name: string; type: string }> = [];
+  try { legacy = JSON.parse(await fs.readFile(path.join(data, "desktop-profile-sync.json"), "utf8")); }
+  catch (error) { if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error; }
+  const profiles: Array<{ key: string; name: string; preset_type: string; setting: ProfileJson; legacy_id?: number; disk: string; file: string }> = [];
+  for (const [category, presetType, disk] of [["machine", "printer", "printers"], ["process", "process", "presets"], ["filament", "filament", "filaments"]]) {
+    const dir = path.join(root, category);
+    const files = await fs.readdir(dir, { recursive: true });
+    for (const file of files.sort()) {
+      if (!file.endsWith(".json")) continue;
+      const absolute = await fs.realpath(path.join(dir, file));
+      if (!absolute.startsWith(root + path.sep)) throw new AppError(400, "Profile links must stay inside the desktop profile folder.");
+      const raw = JSON.parse((await fs.readFile(absolute, "utf8")).replace(/^\uFEFF/, "")) as ProfileJson;
+      if (typeof raw.name !== "string" || !raw.name) continue;
+      const setting = await resolveProfile(raw, category as ProfileCategory, { bundledProfilesPath });
+      preserveCustomPresetIdentity(setting, raw, category as ProfileCategory);
+      setting.type = category;
+      setting.from ??= "system";
+      if (category === "machine" && !setting.machine_start_gcode) throw new AppError(400, `${raw.name}: missing start G-code.`);
+      if (category === "process" && !setting.compatible_printers) throw new AppError(400, `${raw.name}: missing compatible printers.`);
+      const previous = legacy.find(p => path.resolve(p.source) === absolute && p.name === raw.name && p.type === presetType);
+      profiles.push({ key: `${category}/${file.replaceAll("\\", "/")}`, name: raw.name, preset_type: presetType, setting, legacy_id: previous?.id, disk, file });
+    }
+  }
+  if (!profiles.length) throw new AppError(400, "No saved desktop profiles were found.");
+  // Resolve every profile before touching any saved snapshot.
+  const backup = path.join(data, "profile-sync-backups", new Date().toISOString().replaceAll(":", "-"));
+  for (const p of profiles) {
+    const target = path.join(data, p.disk, p.file);
+    try {
+      const old = await fs.readFile(target);
+      const destination = path.join(backup, p.disk, p.file);
+      await fs.mkdir(path.dirname(destination), { recursive: true });
+      await fs.writeFile(destination, old);
+    } catch (error) { if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error; }
+    await fs.mkdir(path.dirname(target), { recursive: true });
+    await fs.writeFile(target + ".tmp", JSON.stringify(p.setting, null, 2));
+    await fs.rename(target + ".tmp", target);
+  }
+  return { profiles: profiles.map(p => ({ key: p.key, name: p.name, preset_type: p.preset_type, setting: p.setting, legacy_id: p.legacy_id })) };
+}
